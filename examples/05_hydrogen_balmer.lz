# The visible hydrogen (Balmer) lines from the Bohr model, in vacuum and in air.
import "qmech" as qm
import "physmath" as m

print("ground state: " + m.fixed(qm.hydrogen_energy_ev(1), 5) + " eV")
for n in [3, 4, 5, 6] {
  let w = qm.hydrogen_wavelength_nm(n, 2)
  print("n=" + str(n) + " -> 2   vacuum " + m.fixed(w, 3) + " nm   air " + m.fixed(qm.vacuum_to_air_nm(w), 3) + " nm   " + m.fixed(qm.photon_energy_ev(w * 0.000000001), 4) + " eV")
}
print("Lyman-alpha: " + m.fixed(qm.hydrogen_wavelength_nm(2, 1), 3) + " nm  (" + qm.hydrogen_series(1) + ")")
