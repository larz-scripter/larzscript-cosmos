# Grover's search: find one item among 2^n with about (pi/4) sqrt(N) queries.
import "qalgo" as qa
import "physmath" as m

for n in [2, 4, 6, 8, 10] {
  let size = 2 ** n
  let g = qa.grover(n, [size - 3])
  print(m.fixed(size, 0) + " items: " + str(g["iterations"]) + " iterations, P(found) = " + m.fixed(g["p_marked"], 6) + "  (a classical search needs ~" + m.fixed((size + 1) / 2.0, 0) + " guesses)")
}
